# ---------------------------------------------------------------------------
# pumpfun-hft secrets. Copy to `.env` (never commit `.env`).
# Every value here is loaded server-side only, wrapped in SecretStr and
# registered with the log redactor so it can never appear in log output.
# ---------------------------------------------------------------------------

# Mode B (authenticated Metis). Bearer token sent as `Authorization: Bearer <JWT>`.
# QuickNode endpoint JWT auth accepts RS256 / ES256 tokens whose `kid` matches the
# key registered on the endpoint. Leave empty to use Mode A (public endpoint) or
# the auto-minting option below.
PUMPFUN_JWT=

# Optional: mint short-lived JWTs automatically instead of pasting one above.
# Path to the PEM private key whose public half is registered with QuickNode,
# and the key id (kid) QuickNode assigned to it.
QN_JWT_PRIVATE_KEY_PATH=
QN_JWT_KID=

# Authenticated Metis base URL, e.g. https://<name>.solana-mainnet.quiknode.pro/<token>
# (Metis REST paths such as /pump-fun/quote are appended to this URL).
METIS_URL=

# Solana JSON-RPC (HTTP) and WebSocket endpoints.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# Trading wallet secret key: base58 string (64-byte secret) or JSON byte array.
# Only required for `live` mode. Paper trading and backtests never read it.
PRIVATE_KEY=

# Optional: Jito block engine auth / UUID (only if your account has one).
JITO_AUTH_UUID=

# Optional: bearer token for the (unofficial) pump.fun frontend API client.
PUMPFUN_FRONTEND_JWT=
